    "@formspark/use-formspark": "^0.1.39",
    "@mdx-js/react": "^3.0.0",
    "@mendable/search": "^0.0.206",
    "@splidejs/react-splide": "^0.7.12",
    "bootstrap": "5.3.3",
    "buffer": "^6.0.3",
